#!/usr/bin/env node
/**
 * The stub `hermes` binary of the Hermes host's fixtures (T008): the same argv
 * recorder as the stub CLI, with scripted answers for `--version`,
 * `plugins enable|disable|list --json`, `config get <key>`, `send` and
 * `skills list`. A test asserts the calls the installer, the doctor and the
 * plugin glue make (F150-FR-022, F150-SC-002) and lets the environment
 * override any of them:
 *
 * - `$STUB_SCRIPT` — an argv-prefix → {stdout, stderr, exit} map, as in the
 *   stub CLI (the longest matching prefix wins, an exact match always does);
 * - `$STUB_HERMES_VERSION` — the `--version` line (default `hermes 0.22.2`);
 * - `$STUB_PLUGINS` — the `plugins list --json` body (a `{plugins: [...]}`);
 * - `$STUB_CONFIG` — a config-key → value map for `config get <key>`;
 * - `$STUB_HERMES_SCRIPT` — its own scripted-step file, overridden by
 *   `$STUB_SCRIPT` where both are set (T004 of feature 151);
 * - the Kanban verbs of feature 151: `kanban create|show|list|schedule|
 *   edit|complete|archive|promote|block|comment|dispatch`, each answering
 *   a `{id, status}` JSON body when `--json` is given, with an optional
 *   `-p <profile>` in front (T004);
 * - a verb outside the closed set exits 2 and is logged `refused: true`;
 * - a failing `send` for F150-FR-037.
 *
 * Matching ignores a leading `-p <profile>` pair, so the doctor's
 * `hermes -p specstride plugins list --json` meets the same scripts as a bare
 * call. An unmatched call exits 2 with the unmatched argv on stderr.
 */
import { recordAndScript, emit } from "./_recorder.mjs";

// Piped stdin, only when a test asks for it (bounded), as in the stub CLI.
async function readStdin() {
  if (process.env.STUB_CAPTURE_STDIN !== "1" || process.stdin.isTTY) return undefined;
  const chunks = [];
  process.stdin.on("data", (chunk) => chunks.push(chunk));
  await new Promise((resolve) => {
    process.stdin.on("end", resolve);
    process.stdin.on("close", resolve);
    process.stdin.on("error", resolve);
    setTimeout(resolve, 2_000);
  });
  return chunks.length > 0 ? Buffer.concat(chunks).toString("utf8") : "";
}

const stdin = await readStdin();

const KANBAN_VERBS = [
  "create", "show", "list", "schedule", "edit", "complete", "archive",
  "promote", "block", "comment", "dispatch",
];

// The default `{id, status}` body per Kanban verb (T004).
const KANBAN_DEFAULTS = {
  create: { id: "card-1", status: "todo" },
  show: { id: "card-1", status: "todo" },
  list: { id: "card-1", status: "todo" },
  schedule: { id: "card-1", status: "scheduled" },
  edit: { id: "card-1", status: "todo" },
  complete: { id: "card-1", status: "done" },
  archive: { id: "card-1", status: "archived" },
  promote: { id: "card-1", status: "ready" },
  block: { id: "card-1", status: "blocked" },
  comment: { id: "card-1", status: "todo" },
  dispatch: { id: "card-1", status: "claimed" },
};

const joinedRaw = process.argv.slice(2).join(" ");
// The profile selector never changes what a verb means in the fixtures.
const normalized = (() => {
  const parts = [];
  for (let i = 0; i < process.argv.length - 2; i += 1) {
    const value = process.argv[2 + i];
    if (value === "-p") { i += 1; continue; }
    parts.push(value);
  }
  return parts.join(" ");
})();
// A Kanban verb outside the closed set is refused (T004): decided before the
// one record the stub writes, so the refused flag lands on that line.
const refused =
  normalized.startsWith("kanban ") && !KANBAN_VERBS.includes(normalized.split(/\s+/)[1]);

const { argv, answer } = recordAndScript({ stdin, refused });

const joined = argv.join(" ") || joinedRaw;

if (answer !== undefined && answer !== null) emit(answer);

if (joined === "--version" || normalized === "--version") {
  process.stdout.write(`hermes ${process.env.STUB_HERMES_VERSION ?? "0.22.2"}\n`);
  process.exit(0);
}

if (normalized === "plugins list --json" || normalized.startsWith("plugins list")) {
  const body = process.env.STUB_PLUGINS
    ? process.env.STUB_PLUGINS
    : JSON.stringify({ plugins: [{ name: "specstride", enabled: false }] });
  process.stdout.write(body + "\n");
  process.exit(0);
}

if (normalized.startsWith("config get ")) {
  const key = normalized.slice("config get ".length).trim();
  let config = { "terminal.backend": "local", "approvals.mode": "ask" };
  try {
    if (process.env.STUB_CONFIG) config = { ...config, ...JSON.parse(process.env.STUB_CONFIG) };
  } catch {
    // An unreadable STUB_CONFIG leaves the defaults in place.
  }
  if (key in config) {
    process.stdout.write(String(config[key]) + "\n");
    process.exit(0);
  }
  process.stderr.write(`stub hermes: no config value for ${key}\n`);
  process.exit(2);
}

const defaults = {
  "plugins enable specstride": "specstride: enabled",
  "plugins disable specstride": "specstride: disabled",
  send: "sent",
  "skills list": "specstride-run\nspecstride-status\nspecstride-curate",
};
for (const prefix of Object.keys(defaults)) {
  if (normalized === prefix || normalized.startsWith(prefix + " ")) {
    process.stdout.write(defaults[prefix] + "\n");
    process.exit(0);
  }
}

// The Kanban verbs of feature 151: a closed set; anything else is refused.
if (normalized.startsWith("kanban ")) {
  const verb = normalized.split(/\s+/)[1];
  if (refused) {
    process.stderr.write("stub hermes: refused kanban verb: " + verb + "\n");
    process.exit(2);
  }
  if (answer !== undefined && answer !== null) emit(answer);
  if (argv.includes("--json")) {
    const body = { ...KANBAN_DEFAULTS[verb] };
    if (verb === "list" && !process.env.STUB_HERMES_SINGLE_LIST) {
      process.stdout.write(JSON.stringify([KANBAN_DEFAULTS.list]) + "\n");
    } else {
      process.stdout.write(JSON.stringify(body) + "\n");
    }
    process.exit(0);
  }
  process.stdout.write(`card-1: ${verb} ok\n`);
  process.exit(0);
}

// A verb outside the closed set the fixtures know is refused (the refused
// flag was already decided and logged on the one record above).
process.stderr.write("stub hermes: no scripted answer for: " + joined + "\n");
process.exit(2);
