# Written by the mixture-of-loops skill (2026-11-06): keep generated pipeline
# artifacts out of git status; the contract and its verification plan stay committable.
.mixture-of-loops/**
!.mixture-of-loops/**/
!.mixture-of-loops/**/launch-contract.json
!.mixture-of-loops/**/verification-commands.json
!.mixture-of-loops/**/health-check.sh
.mixture-of-loops/**/generated/
.mixture-of-loops/**/runs/

# The split (phase 5, 2026-11-11): pipeline state and Spec Kit scaffolding stay
# local, as they are in the engine repository. The run state under .specstride/
# holds campaign files that must not enter git history (rule 6 of the split).
.specstride/
.specstride*/
.specify/

# The pinned core: `core-pin.json` and the sha256-pinned tarballs it names under
# vendor/core/*.tgz are both TRACKED (constitution H4). This fixes dsh's defect, where
# vendor/core/ was ignored yet a tarball was force-added. Do not ignore vendor/core/.
node_modules/
tmp/
.build/

# Spec corpus and pipeline artifacts stay local (owner, 2026-11-08): the Spec Kit
# specs, the Specstride / Mixture of Loops contracts, test plans, prompts and
# research that drove the build. The runtime contracts the build reads live in
# contracts/ (tracked); specs/<feature>/contracts/ link to them locally.
specs/
.mixture-of-loops/
testautomation/
prompts/
research/

# Speckit / Specstride artifacts stay local (explicit, owner request 2026-11-08):
# Spec Kit scaffolding and memory, Specstride run state, task specs, the prompt
# kit, the research corpus, verification/test-plan artifacts, and the flat spec
# entry file. Nothing under these paths ever enters git history.
.specify/
.specify/**
.specstride/
.specstride*/
SPECS.md
SPECS*.md
specs/**
prompts/**
research/**
testautomation/**

# The runtime contracts the build reads stay tracked (plan of 150: contracts/
# are mirrors the build reads); only the ignore block above them, which names
# bare path stems, must not swallow them.
!contracts/
!contracts/**

# Test fixtures are workspaces too: their specs/ and .specstride/ ARE the fixture
# data (gen-corpus.ts: "The output is committed"). The two rules above swallowed
# them, so a public clone failed 46 tests. Track them.
!tests/fixtures/workspaces/*/specs/
!tests/fixtures/workspaces/*/.specstride/
