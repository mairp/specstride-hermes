  "proposedByFeature": [
    {
      "id": "kanban-tab-identity",
      "members": [
        {
          "path": "/specstride",
          "position": "after:kanban",
          "override": null
        }
      ],
      "rule": "no tab.override; any other value fails the build (F151-FR-018)"
    },
    {
      "id": "kanban-cli-verbs",
      "members": [
        {
          "argv": [
            "status",
            "--json"
          ]
        },
        {
          "argv": [
            "wait",
            "--until-change",
            "--cursor",
            "<token>",
            "--timeout",
            "<seconds>"
          ]
        },
        {
          "argv": [
            "stop"
          ],
          "when": "specstride.kanban.actions: true"
        },
        {
          "argv": [
            "stop",
            "--now"
          ],
          "when": "specstride.kanban.actions: true"
        },
        {
          "argv": [
            "resume"
          ],
          "when": "specstride.kanban.actions: true"
        }
      ],
      "rule": "spawned only through 150's shim; any other argv is refused with no CLI call; the shim's own --protocol probe is 150's check, tagged probe by the stub, and not a verb of this feature (F151-FR-021, F151-FR-051)"
    },
    {
      "id": "kanban-view-sources",
      "members": [
        "engine",
        "workspace-reader"
      ],
      "rule": "an absent source member reads as engine; any other value refuses the view (F151-FR-035)"
    },
    {
      "id": "kanban-api-answers",
      "members": [
        "view",
        "unchanged",
        "no-run",
        "absent",
        "refused-schema",
        "unavailable",
        "run-changed"
      ],
      "rule": "every 200 body carries one in answer; anything else reads as unavailable (F151-FR-023)",
      "session": [
        "token",
        "expiresAt",
        "actions",
        "laneThreshold"
      ]
    },
    {
      "id": "kanban-reader-inputs",
      "members": [
        {
          "n": 1,
          "path": "specs/<f>/tasks.md",
          "gives": "phases, scope, ticks"
        },
        {
          "n": 2,
          "path": ".specstride/workspace.json",
          "gives": "the workspace id"
        },
        {
          "n": 3,
          "path": ".specstride/events.jsonl",
          "gives": "the bash engine's event stream"
        },
        {
          "n": 4,
          "path": ".specstride/features/<f>/gates/ (names), .specstride/features/<f>/evidence/ (names and sizes)",
          "gives": "gate approvals; evidence name and size, never its text"
        },
        {
          "n": 5,
          "path": ".specstride/launches/launch-*/{launch,supervision,runtime.status}.json",
          "gives": "launches"
        },
        {
          "n": 6,
          "path": ".specstride/active, .specstride/features/<f>/runs/run-launch-*/lease.json",
          "gives": "the launch owner's pid and start"
        },
        {
          "n": 7,
          "path": ".specstride/state/pipeline/<f>/runs/<launch>/state.json",
          "gives": "the pipeline's end record"
        },
        {
          "n": 8,
          "path": "~/.specstride/workspaces/<id16>/ (also the full id, and $XDG_STATE_HOME/specstride/workspaces/): runs/*/events.jsonl, procs.json, features/<f>/{approvals,bound,micro,feedback,set-aside}/, features/<f>/{ledger,loop}.json",
          "gives": "the TS engine's runs, process registry, approvals, counters, units, critic feedback verdict lines"
        },
        {
          "n": 9,
          "path": "/proc/<pid>/{stat,cmdline} for recorded pids, /proc/stat",
          "gives": "liveness; harness, profile, model, role"
        },
        {
          "n": 10,
          "path": "~/.dsh/sessions/<cwd-slug>/ and worker roots named after the feature's runs",
          "gives": "usage",
          "when": "only when the run's proposer harness is dsh"
        }
      ],
      "bounds": {
        "eventTailBytes": 8388608,
        "jsonRecordBytes": 262144,
        "tasksMdBytes": 2097152
      },
      "rule": "read-only; a path outside the list is never opened; no process is spawned; nothing is written (F151-FR-034)"
    },
    {
      "id": "kanban-reader-lane-rules",
      "ordered": true,
      "members": [
        {
          "rule": "W0",
          "when": "nothing has started the feature (no run, no approval, no ticked task)",
          "lane": "queued",
          "card": "one card <feature>#queued"
        },
        {
          "rule": "W1",
          "when": "the run is not ended and its current phase is this phase",
          "lane": "the run's live lane (kanban-reader-live-lanes), proposing when it has none"
        },
        {
          "rule": "W2",
          "when": "the run ended all_approved, or an approval record or gate of the phase exists, or the run recorded phase.ended approved, or every task of the phase is ticked",
          "lane": "approved"
        },
        {
          "rule": "W3",
          "when": "the run is ended and its current phase is this phase",
          "lane": "the end lane (kanban-reader-end-rules)"
        },
        {
          "rule": "W4",
          "when": "otherwise",
          "lane": "queued"
        }
      ],
      "rule": "first match wins, in this order; ruleId is W-<lane>; no lane is assigned outside src/kanban/reader/lanes.ts (F151-FR-038, F151-FR-049)"
    },
    {
      "id": "kanban-reader-live-lanes",
      "members": [
        "proposing",
        "verifying",
        "reviewing",
        "paused",
        "blocked"
      ],
      "unknown": "proposing"
    },
    {
      "id": "kanban-reader-end-rules",
      "ordered": true,
      "members": [
        {
          "when": "phase.ended outcome blocked",
          "lane": "blocked"
        },
        {
          "when": "phase.ended outcome stopped",
          "lane": "paused"
        },
        {
          "when": "phase.ended outcome other than approved",
          "lane": "failed"
        },
        {
          "when": "pipeline state.json stopped (not running, not dry-run, not older than the run's last event)",
          "lane": "paused"
        },
        {
          "when": "pipeline state.json completed",
          "lane": null
        },
        {
          "when": "pipeline state.json any other state that is not running",
          "lane": "failed"
        },
        {
          "when": "launch signalled, stopped, or stop requested",
          "lane": "paused"
        },
        {
          "when": "launch exited 0 or completed",
          "lane": null
        },
        {
          "when": "any other launch state that is not running",
          "lane": "failed"
        },
        {
          "when": "no launch, procs.json present, no alive process, 120 s without an event",
          "lane": "failed"
        },
        {
          "when": "bash engine outcome matching yield|pause|stop|quota",
          "lane": "paused"
        },
        {
          "when": "bash engine outcome matching human|halt|block",
          "lane": "blocked"
        }
      ],
      "unknown": "failed",
      "constants": {
        "startToleranceMs": 1000,
        "silentRunMs": 120000,
        "staleAfterMs": 7200000
      }
    },
    {
      "id": "kanban-launch-states",
      "members": [
        "running",
        "exited",
        "completed",
        "stopped",
        "signalled",
        "failed",
        "lost"
      ],
      "unknown": "? with the raw value"
    },
    {
      "id": "kanban-signature-members",
      "members": [
        "cards: id, lane, flags.stale",
        "attention: key, oneLine",
        "launches: launchId, state",
        "run: id, launch, state, phase, startedAt, lastAt",
        "agents: role, pid, what",
        "usage: calls, retries",
        "phase: tasksDone, attempts (outcome, passes), counters, units"
      ],
      "rule": "sha256 over these in this order (F151-FR-040)"
    },
    {
      "id": "kanban-engine-memo",
      "constants": {
        "retryMs": 60000,
        "maxWorkspaces": 64
      },
      "rule": "set by an engine answer that is unavailable, or valid with no card while the reader gave cards; cleared by an engine view that carries a card (F151-FR-039)"
    },
    {
      "id": "kanban-inspector-sections",
      "ordered": true,
      "members": [
        "scope",
        "live",
        "attempts",
        "launches",
        "cost"
      ],
      "labels": [
        "Scope",
        "Live",
        "Attempts",
        "Launches",
        "Cost and limits"
      ]
    },
    {
      "id": "kanban-detail-bounds",
      "constants": {
        "textBytes": 240,
        "taskTextBytes": 160,
        "tasks": 60,
        "files": 12,
        "attempts": 12,
        "launches": 12,
        "agents": 8,
        "models": 6
      },
      "rule": "cut with an omitted count (F151-FR-044)"
    },
    {
      "id": "kanban-never-in-a-view",
      "members": [
        "absolute path",
        "prompt",
        "reply",
        "tool argument",
        "command line",
        "signature",
        "key",
        "log line"
